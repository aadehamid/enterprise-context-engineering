digraph ECE {
  graph [layout=neato, splines=polyline, overlap=true, bgcolor="#ffffff", pad=0.3,
    fontname="Arial", fontsize=22, labelloc=t,
    label="Enterprise context engineering\nProposed knowledge platform with open-source components"];
  node [shape=box, style="rounded,filled", fillcolor="#f3f6fb", color="#a5b5d0",
    fontname="Arial", fontsize=12, margin="0.18,0.12"];
  edge [color="#304b70", arrowsize=0.7, fontname="Arial", fontsize=10];

  subgraph cluster_sources {
    graph [bb="290,1360,910,1510", lp="600,1485"];
    label="1. Evidence sources | synthetic fixtures in ECE"; fontsize=16; color="#b4c5db";
    enterprise [pos="450,1430!", label="Enterprise artifacts\nDocuments, email, meetings, notes\nPlanning snapshots and BI extracts"];
    ci [pos="750,1430!", label="CI processes and SME knowledge\nBackcasts, lookbacks, audits\nTrackers, reports and supplied rationale"];
    {rank=same; enterprise; ci;}
  }
  subgraph cluster_capture {
    graph [bb="0,855,910,1340", lp="455,1315"];
    label="2. Capture and restricted landing"; fontsize=16; color="#b4c5db";
    gateway [pos="600,1240!", label="Capture gateway\nConnectors, mailbox feed, manual upload\nSource IDs, timestamps and access labels"];
    event [pos="450,1090!", label="Event intake and triage\nDagster sensors; Kafka only if justified\nAsynchronous capture and routing"];
    batch [pos="750,1090!", label="Scheduled batch intake\nDagster OSS\nRepositories, snapshots, email, notes"];
    bronze [pos="150,940!", label="Raw / Bronze\nImmutable original artifacts\nS3-compatible storage; Ceph candidate"];
    sensitivity [pos="450,940!", label="Sensitivity review\nRestricted hold until cleared\nNo indexing or user alerts while held", fillcolor="#fff0d9"];
    alerts [pos="750,940!", label="Context-based alert rules\nCleared event, authorized recipients\nNotification does not imply approval"];
    {rank=same; event; batch;}
    {rank=same; bronze; sensitivity; alerts;}
  }
  subgraph cluster_context {
    graph [bb="0,620,1200,815", lp="600,790"];
    label="3. Contextualization | Refined / Silver"; fontsize=16; color="#b4c5db";
    semantics [pos="150,710!", label="Versioned semantic contracts\nVocabulary, taxonomy, ontology, templates\nEPM domain imports + ECE context\nRDF / SKOS / SHACL; Jena / RDFLib"];
    parse [pos="450,710!", label="Content processing\nOCR, layout, speech, tables\nDeduplicate, chunk and classify\nDocling, Tesseract, Whisper candidates"];
    draft [pos="750,710!", label="LLM contextualization: drafts only\nLessons, stated rationale and taxonomy\nEntities, relationships, quality / confidence\nCitations and temporal validity\nMLflow optional; model license check required"];
    review [pos="1050,710!", label="SME / manager review gate\nLow-confidence report and corrections\nHuman approval + medium/high quality\nRequired provenance and access checks", fillcolor="#fff0d9"];
    {rank=same; semantics; parse; draft; review;}
  }
  subgraph cluster_storage {
    graph [bb="300,405,1200,595", lp="750,570"];
    label="4. Approved knowledge and catalog"; fontsize=16; color="#b4c5db";
    gold [pos="450,490!", label="Core / Gold\nApproved, versioned records\nPostgreSQL; DuckDB / Parquet\nDuckLake when history warrants it", fillcolor="#e6f3ec"];
    knowledge_graph [pos="750,490!", label="Approved knowledge graph\nDecision, lesson, outcome, asset, SME\nClaim-level evidence and validity\nJena / Fuseki + Neo4j Community"];
    catalog [pos="1050,490!", label="Catalog and pipeline lineage\nOpenMetadata + OpenLineage\nAll zones, with restricted metadata\nClaim-level provenance stays in graph"];
    {rank=same; gold; knowledge_graph; catalog;}
  }
  subgraph cluster_delivery {
    graph [bb="0,155,1200,375", lp="600,350"];
    label="5. Retrieval and delivery"; fontsize=16; color="#b4c5db";
    retrieval [pos="450,270!", label="Hybrid retrieval\nPostgreSQL full-text + pgvector\nGraph context; domain / site / region filters\nApproval, time and access enforced"];
    answer [pos="750,270!", label="Cited answers and APIs / MCP\nEvidence / inference / contradiction / unknown\nLive observations labeled separately\nMulti-step reasoning in consumer apps"];
    personas [pos="1050,270!", label="Example consumer roles\nShort-term planner; commercial scheduler\nBackcaster; CI manager; digital owner\nReviewers use a separate Silver queue"];
    live [pos="150,270!", label="Optional direct-to-source adapter\nPlanning and BI: current-state queries\nRead-only, authorized, query/as-of times\nMocked in ECE; production in consumers", style="rounded,filled,dashed", fillcolor="#eef6ff"];
    {rank=same; live; retrieval; answer; personas;}
  }
  subgraph cluster_controls {
    graph [bb="190,-25,1110,135", lp="650,115"];
    label="Cross-cutting controls and isolated evaluation"; fontsize=16; color="#b4c5db";
    governance [pos="350,50!", label="Governance at every stage\nDraft / reviewed / approved / archived\nHigh / medium / low quality; versioned semantics\nKeycloak + OPA candidates; service enforcement\nAudit, retention, lineage and access revocation"];
    evaluation [pos="650,50!", label="Restricted evaluation boundary\nHidden truth accessible only to evaluator\nSeparate credentials, stores, catalogs and traces\nNever exposed through retrieval or live adapters\nSHACL + Great Expectations; release checks"];
    operations [pos="950,50!", label="Operations and feedback\nRetries, deduplication and failed-event review\nGrafana OSS; restricted evaluation traces\nSME corrections return to Silver review"];
    {rank=same; governance; evaluation; operations;}
  }

  enterprise -> gateway [style=dashed]; ci -> gateway [style=dashed];
  gateway -> event [style=dashed]; gateway -> batch [style=dashed];
  event -> bronze [style=dashed]; batch -> bronze [style=dashed];
  bronze -> sensitivity [style=dashed, label="all intake"];
  sensitivity -> alerts [style=dashed, label="cleared events"];
  sensitivity -> parse [style=dashed, label="cleared artifacts"];
  semantics -> parse [style=dotted, arrowhead=none];
  parse -> draft [style=dashed]; draft -> review [style=dashed];
  review -> gold [style=dashed, label="approved + eligible", pos="e,450,530 1050,665 1050,610 450,610 450,540"];
  gold -> knowledge_graph [style=dashed, label="approved projection"];
  gold -> retrieval [style=dashed, label="index eligible versions"];
  knowledge_graph -> retrieval [label="query", pos="e,450,310 750,445 750,400 450,400 450,320"];
  retrieval -> answer;
  live -> answer [label="current observation", pos="e,640,230 150,230 150,180 650,180 650,220"];
  answer -> personas;

  legend [pos="650,-110!", shape=plain, fillcolor="white", fontsize=11,
    label="Solid arrow: request / response    Dashed arrow: asynchronous or batch\nDotted line: semantic association    Dashed box: optional consumer integration\nAll capabilities are proposed; this is not a deployment inventory."];
}
